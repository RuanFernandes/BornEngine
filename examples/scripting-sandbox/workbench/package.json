{
  "name": "bornengine-scripting-sandbox-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/validate-dist.mjs",
    "check": "node scripts/check-types.mjs",
    "test": "tsx --test test/*.test.ts",
    "e2e": "node ../scripts/dev.mjs --build-preview-only && playwright test"
  },
  "dependencies": {
    "@bornengine/engine": "file:../../../",
    "@colyseus/sdk": "0.18.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "@bornengine/engine/*"
      ]
    }
  }
}

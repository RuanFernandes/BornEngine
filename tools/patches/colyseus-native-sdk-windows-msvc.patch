diff --git a/build.zig b/build.zig
index d3a1714..70da11c 100644
--- a/build.zig
+++ b/build.zig
@@ -184,8 +184,14 @@ fn buildSdk(b: *std.Build) void {
             },
-            .flags = &.{
-                "-Wall",
-                "-Wextra",
-                c_std,
-                "-DHAVE_CONFIG_H",
-            },
+            .flags = if (is_windows)
+                &.{
+                    "-Wall",
+                    "-Wextra",
+                    c_std,
+                    "-DHAVE_CONFIG_H",
+                    "-Dssize_t=intptr_t",
+                    "-DWIN32_LEAN_AND_MEAN",
+                    "-Wno-newline-eof",
+                }
+            else
+                &.{ "-Wall", "-Wextra", c_std, "-DHAVE_CONFIG_H" },
         });
@@ -557,4 +563,11 @@ fn buildSdk(b: *std.Build) void {
     const base_flags = [_][]const u8{ "-Wall", "-Wextra", "-pedantic", c_std };
+    const windows_base_flags = base_flags ++ [_][]const u8{
+        "-Dssize_t=intptr_t",
+        "-DWIN32_LEAN_AND_MEAN",
+        "-Wno-newline-eof",
+    };
     const base_flags_hidden_cjson =
         base_flags ++ [_][]const u8{cjson_hide_symbols_flag};
+    const windows_base_flags_hidden_cjson =
+        windows_base_flags ++ [_][]const u8{cjson_hide_symbols_flag};
     const web_flags = [_][]const u8{ "-Wall", "-Wextra", "-pedantic", "-Wno-newline-eof", c_std, "-DPLATFORM_WEB" };
@@ -566,4 +579,8 @@ fn buildSdk(b: *std.Build) void {
             &web_flags
+        else if (hide_cjson_exports and is_windows)
+            &windows_base_flags_hidden_cjson
         else if (hide_cjson_exports)
             &base_flags_hidden_cjson
+        else if (is_windows)
+            &windows_base_flags
         else
@@ -589,3 +606,6 @@ fn buildSdk(b: *std.Build) void {
             .files = &native_network_sources,
-            .flags = &base_flags,
+            .flags = if (is_windows)
+                &windows_base_flags
+            else
+                &base_flags,
         });

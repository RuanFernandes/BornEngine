{
  "name": "@bornengine/docs-site",
  "version": "1.0.0",
  "description": "BornEngine homepage and documentation site",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind",
    "check": "astro check && node scripts/validate-content.mjs",
    "test": "node --test tests",
    "validate:dist": "node scripts/validate-links.mjs",
    "preview": "astro preview"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}

---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { defaultSiteUrl, siteName, withBase } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  theme?: 'ink' | 'paper';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  theme = 'paper',
  jsonLd,
} = Astro.props;
const origin = Astro.site ?? new URL(defaultSiteUrl);
const canonical = new URL(withBase(canonicalPath), origin).href;
const socialImage = new URL(withBase('/og-image.svg'), origin).href;
const structuredData = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" data-theme={theme} data-base-path={withBase('/')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="stylesheet" href={withBase('/_pagefind/pagefind-ui.css')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title} · {siteName}</title>
    {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class:list={[`theme-${theme}`]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/copy-code.ts';
      import '../scripts/docs-navigation.ts';
      import '../scripts/search.ts';
    </script>
  </body>
</html>

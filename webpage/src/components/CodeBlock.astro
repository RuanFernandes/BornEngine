---
interface Props {
  code: string;
  language?: string;
  filename?: string;
}

const { code, language = 'text', filename } = Astro.props;
---

<figure class="code-block" data-code-block data-monaco-code data-monaco-language={language}>
  <figcaption>
    <span class="code-block__language">{filename ?? language}</span>
    <button type="button" data-copy-code>Copy</button>
    <span class="code-block__status" aria-live="polite"></span>
  </figcaption>
  <div
    class="code-block__monaco"
    data-monaco-editor
    aria-hidden="true"
    aria-label={`${filename ?? language} code editor`}
  ></div>
  <pre data-monaco-fallback><code class={`language-${language}`}>{code}</code></pre>
</figure>

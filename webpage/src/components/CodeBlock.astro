---
interface Props {
  code: string;
  language?: string;
  filename?: string;
}

const { code, language = 'text', filename } = Astro.props;
---

<figure class="code-block" data-code-block>
  <figcaption>
    <span>{filename ?? language}</span>
    <button type="button" data-copy-code data-code={code}>Copy</button>
    <span class="code-block__status" aria-live="polite"></span>
  </figcaption>
  <pre><code class={`language-${language}`}>{code}</code></pre>
</figure>

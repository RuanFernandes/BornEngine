<button class="site-header__search" type="button" data-search-open aria-haspopup="dialog">
  Search <kbd>/</kbd>
</button>

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-dialog__inner">
    <div class="search-dialog__header">
      <h2 id="search-title">Search BornEngine docs</h2>
      <button class="search-dialog__close" type="button" data-search-close aria-label="Close search">Esc</button>
    </div>
    <div data-pagefind-ui></div>
    <p class="search-dialog__fallback" data-search-fallback>Search loads when you open it. Navigation remains available without JavaScript.</p>
  </div>
</dialog>

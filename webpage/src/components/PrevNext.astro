---
import { withBase } from '../data/site';

interface LinkItem {
  title: string;
  href: string;
}

interface Props {
  previous?: LinkItem;
  next?: LinkItem;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="prev-next" aria-label="Documentation sequence">
    {previous ? <a class="prev-next__link" href={withBase(previous.href)}><span>← Previous</span><strong>{previous.title}</strong></a> : <span />}
    {next ? <a class="prev-next__link prev-next__link--next" href={withBase(next.href)}><span>Next →</span><strong>{next.title}</strong></a> : <span />}
  </nav>
)}

---
import Brand from './Brand.astro';
import { repoUrl, withBase } from '../data/site';
---

<header class="site-header">
  <div class="site-header__inner">
    <Brand />
    <button class="site-header__menu" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
      <span class="visually-hidden">Open navigation</span>
      <span aria-hidden="true">Menu</span>
    </button>
    <nav class="site-header__nav" id="site-navigation" aria-label="Primary navigation" data-site-menu>
      <a href={withBase('/')}>Home</a>
      <a href={withBase('/docs/')}>Docs</a>
      <a href={withBase('/docs/cli/')}>CLI</a>
      <a href={repoUrl} rel="noreferrer">GitHub</a>
      <a class="site-header__cta" href={withBase('/docs/getting-started/')}>Get started <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
